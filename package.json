{
  "name": "szymonrokicki-pl",
  "version": "1.0.0",
  "private": true,
  "description": "Statyczna strona szymonrokicki.pl",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:search && npm run build:sitemap",
    "build:css": "lightningcss --bundle --minify assets/css/public.css -o assets/css/public.min.css",
    "build:sitemap": "node tools/build-sitemap.mjs",
    "build:search": "node tools/build-search-index.mjs",
    "check": "node tools/check-site.mjs",
    "test": "npm run check"
  },
  "devDependencies": {
    "lightningcss-cli": "^1.33.0",
    "parse5": "^8.0.1"
  }
}
